<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Loan Department">
  <test thread-count="5" name="Personal Loan">
    <classes>
      <class name="test.Section16Day1">
		  <methods>
			  <include name="Demo.*"></include>
		  </methods>
      </class>
      <class name="test.Section16Day2">
		  <methods>
			  <include name="PayLoan"></include>
		  </methods>
      </class>
    </classes>
  </test> <!-- Personal Loan Test -->
  <test thread-count="5" name="Car Loan">
    <classes>
      <class name="test.Section16Day3">
		  <methods>
			  <exclude name="LoginAPICarLoan"></exclude>
		  </methods>
      </class>
    </classes>
  </test> <!-- Car Loan Test -->
  <test thread-count="5" name="Home Loan">
    <classes>
      <class name="test.Section16Day4">
		  <methods>
			  <exclude name="Mobile.*"></exclude>
		  </methods>
      </class>
    </classes>
  </test> <!-- Home Loan Test -->
</suite> <!-- Suite -->
